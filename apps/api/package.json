{
  "name": "@teachgrow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TeachGrow Attendance REST API (Express 5, TypeScript)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "bootstrap:admin": "tsx src/scripts/bootstrap-admin-cli.ts",
    "bootstrap:admin:prod": "node dist/scripts/bootstrap-admin-cli.js"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "@supabase/auth-js": "^2.119.0",
    "@teachgrow/shared": "*",
    "cookie": "^2.0.1",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "jose": "^6.2.15",
    "pg": "^8.13.0",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "vitest": "^4.1.12"
  }
}
