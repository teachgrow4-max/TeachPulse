# TeachGrow Attendance API — environment template.
# Copy to `.env` (git-ignored) and fill in real values. NEVER commit real secrets.
# Server-side only: none of these values may ever be placed in the web or mobile bundles.
# Every value is validated at startup; the process refuses to boot on a missing or unsafe one.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ---- Database ---------------------------------------------------------------------------------
# Postgres connection string. For local dev, `npm run db:start` prints the DB URL.
# Hosted Supabase: from the dashboard's Connect dialog copy the "Session pooler" string (host
# aws-N-<region>.pooler.supabase.com, port 5432, user postgres.<project-ref>). It works over IPv4.
# The "Direct connection" host (db.<project-ref>.supabase.co) is IPv6-only unless the project has the
# IPv4 add-on, and many hosting platforms cannot reach it. Characters such as @ / # ? : in the
# password must be percent-encoded.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres
# Set to true for hosted Postgres that requires TLS (Supabase cloud). Required in production.
DB_SSL=false
# The API always verifies the database's certificate. Supabase signs with its own certificate
# authority, which Node does not know, so give the API that authority's certificate: dashboard ->
# Project Settings -> Database -> SSL Configuration -> Download certificate, then paste the file's
# text here (line breaks may be written as \n so it fits on one line). Public, not a secret.
# DB_SSL_CA=
DB_POOL_MAX=10

# ---- Supabase ---------------------------------------------------------------------------------
# Project URL (local: values printed by `npx supabase status`). Must be https in production.
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_ANON_KEY=replace-with-anon-key
# SECRET. Grants full database/auth access. Server environment only.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# How access tokens are verified. Projects with asymmetric signing keys need NOTHING here: the
# public keys are fetched from <SUPABASE_URL>/auth/v1/.well-known/jwks.json.
# Legacy projects (shared HS256 secret) set the secret, at least 32 characters. SECRET.
# SUPABASE_JWT_SECRET=
# Only if your keys or issuer are served from a different address than SUPABASE_URL:
# SUPABASE_JWKS_URL=
# JWT_ISSUER=

# ---- Web access -------------------------------------------------------------------------------
# Comma-separated list of browser origins (scheme + host + port, no path) allowed to call the
# API. These are also the only origins accepted for cookie-based sign-in / refresh / sign-out.
CORS_ORIGINS=http://localhost:5173

# ---- Office verification (see docs/VERIFICATION.md) -------------------------------------------
# SECRET. Signs the rotating office QR codes; at least 32 characters, server environment only.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it invalidates the codes on screen at that moment; the display picks up new ones.
QR_SIGNING_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
# WebAuthn relying party for browser passkeys. The id is the web app's domain; it defaults to the
# host of the first CORS_ORIGINS entry. Changing it later orphans every registered browser.
# WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=TeachGrow Attendance

# How many reverse proxies sit in front of the API, or a comma-separated list of
# trusted proxy IPs/CIDRs. `false` means "no proxy": req.ip is the socket address.
# NEVER use `true` or `*`. Must be set explicitly in production. See docs/DEPLOYMENT.md.
TRUST_PROXY=false

# ---- Sessions (see docs/AUTH.md) --------------------------------------------------------------
# strict: web app and API on the same site. none: different sites (needs HTTPS / Secure).
AUTH_COOKIE_SAMESITE=strict
# Defaults to true in production and false otherwise; production refuses false.
# AUTH_COOKIE_SECURE=true
# Lifetime of the web refresh cookie, in days.
AUTH_COOKIE_DAYS=7

# ---- Lockout and rate limits ------------------------------------------------------------------
# Lock an account after this many failed sign-ins within the lockout window.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# Failed sign-ins allowed per client IP per 15 minutes (successes are not counted).
LOGIN_IP_FAILURE_LIMIT=30
# Requests per minute per client IP across the whole API (high: an office can share one IP).
RATE_LIMIT_GLOBAL_PER_MIN=1000
# Requests per minute per signed-in user.
USER_RATE_LIMIT_PER_MIN=240

# ---- First administrator (used only by `npm run bootstrap:admin`) -----------------------------
# Optional. Anything not set is asked for interactively. Unset the password afterwards.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_CODE=
# BOOTSTRAP_ADMIN_JOINING_DATE=
# BOOTSTRAP_ADMIN_PASSWORD=
